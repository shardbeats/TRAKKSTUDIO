/* TRAKKSTUDIO — ShardBeats TRAKK SUITE theme (heritage CONVERTER/NORMALIZER).
Palette: bg #151617, panel #1C1D1F, input #202124, border #45474A,
text #E5E5E5, muted #92959A, accent amber #F5A623, hover #FFB52E,
pressed #d8901d, on-accent #161617, disabled #383B40, footer #6E7175.
No inline colors in Python — all chrome here. */

QMainWindow, QWidget {
    background-color: #151617;
    color: #E5E5E5;
    font-family: "Segoe UI", sans-serif;
    font-size: 13px;
}

/* ---- Brand header / footer ---- */
QLabel#titleLabel {
    font-size: 19px;
    font-weight: bold;
    color: #E5E5E5;
    letter-spacing: 1px;
}
QLabel#subtitleLabel {
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 2px;
    color: #F5A623;
}
QLabel#footerLabel {
    font-size: 11px;
    color: #6E7175;
    letter-spacing: 1px;
}
QLabel#statusLabel { font-size: 12px; color: #92959A; }
QLabel#warnLabel { font-size: 12px; font-weight: bold; color: #F5A623; }

/* ---- Group panels ---- */
QGroupBox {
    background-color: #1C1D1F;
    border: 1px solid #45474A;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 2px;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 2px;
    color: #92959A;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    background-color: transparent;
}

/* ---- Queue table (same tokens as heritage dropList) ---- */
QTableWidget {
    background-color: #202124;
    border: 1px dashed #55585C;
    border-radius: 4px;
    gridline-color: #2A2C30;
    selection-background-color: #33363B;
    selection-color: #F5A623;
    outline: none;
}
QTableWidget::item:selected { background-color: #33363B; color: #F5A623; }
QHeaderView::section {
    background-color: #1C1D1F;
    color: #92959A;
    border: none;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 4px;
}

/* ---- Tabs (multitool): same dark + amber selected ---- */
QTabWidget::pane { border: 1px solid #45474A; background-color: #151617; }
QTabBar::tab {
    background-color: #1C1D1F;
    color: #92959A;
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: bold;
    letter-spacing: 1px;
}
QTabBar::tab:selected { background-color: #202124; color: #F5A623; }
QTabBar::tab:hover:!selected { color: #E5E5E5; border: 1px solid #45474A; }

/* ---- Inputs ---- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #202124;
    border: 1px solid #45474A;
    border-radius: 4px;
    padding: 6px 10px;
    color: #E5E5E5;
    font-size: 12px;
}
QLineEdit:hover, QComboBox:hover { border-color: #F5A623; }
QComboBox QAbstractItemView {
    background-color: #202124;
    border: 1px solid #45474A;
    selection-background-color: #33363B;
    selection-color: #F5A623;
    color: #E5E5E5;
    outline: none;
}
QTextEdit {
    background-color: #101013;
    border: 1px solid #45474A;
    border-radius: 4px;
    color: #E5E5E5;
}

/* ---- Buttons ---- */
QPushButton {
    background-color: #202124;
    border: 1px solid #45474A;
    border-radius: 4px;
    padding: 6px 12px;
    color: #E5E5E5;
    font-weight: bold;
    font-size: 12px;
}
QPushButton:hover { border-color: #F5A623; color: #F5A623; }
QPushButton:pressed { background-color: #F5A623; border-color: #F5A623; color: #161617; }
QPushButton:disabled { background-color: #1C1D1F; border-color: #45474A; color: #383B40; }

/* Primary actions (one per tab, same amber block as heritage convertBtn) */
QPushButton#convertBtn {
    background-color: #F5A623;
    border: none;
    border-radius: 6px;
    padding: 12px 24px;
    color: #161617;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 2px;
}
QPushButton#convertBtn:hover { background-color: #FFB52E; color: #161617; }
QPushButton#convertBtn:pressed { background-color: #d8901d; color: #161617; }
QPushButton#convertBtn:disabled { background-color: #2A2C30; border: 1px solid #45474A; color: #383B40; }

QPushButton#browseBtn {
    background-color: transparent;
    border: none;
    color: #92959A;
}
QPushButton#browseBtn:hover { color: #F5A623; background-color: #2A2C30; }
QPushButton#browseBtn:pressed { color: #161617; background-color: #F5A623; }

/* ---- Progress ---- */
QProgressBar {
    background-color: #202124;
    border: 1px solid #45474A;
    border-radius: 4px;
    text-align: center;
    color: #E5E5E5;
    font-weight: bold;
    font-size: 12px;
}
QProgressBar::chunk { background-color: #F5A623; border-radius: 3px; }

/* ---- Checks / radios ---- */
QCheckBox, QRadioButton { color: #E5E5E5; font-size: 12px; spacing: 6px; }
QCheckBox:hover, QRadioButton:hover { color: #F5A623; }
QCheckBox::indicator {
    width: 14px; height: 14px;
    border: 1px solid #45474A; border-radius: 3px;
    background-color: #202124;
}
QCheckBox::indicator:checked { background-color: #F5A623; border-color: #F5A623; }

/* ---- Scrollbars ---- */
QScrollBar:vertical { background-color: #1C1D1F; width: 8px; border: none; margin: 2px; }
QScrollBar::handle:vertical { background-color: #45474A; border-radius: 4px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background-color: #F5A623; }
QScrollBar:horizontal { background-color: #1C1D1F; height: 8px; border: none; margin: 2px; }
QScrollBar::handle:horizontal { background-color: #45474A; border-radius: 4px; min-width: 24px; }
QScrollBar::handle:horizontal:hover { background-color: #F5A623; }
